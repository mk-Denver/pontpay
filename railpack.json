{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        { "src": "package.json", "dest": "package.json" },
        { "src": "package-lock.json", "dest": "package-lock.json" },
        { "cmd": "npm install --legacy-peer-deps", "customName": "Install dependencies" },
        { "path": "node_modules/.bin" }
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "npx vite build -l error",
        "cp dist/index.html dist/404.html"
      ]
    }
  },
  "deploy": {
    "startCommand": "npx serve dist -l ${PORT:-3000} -s"
  }
}
